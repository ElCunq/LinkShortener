# ==========================================
# Link Shortener SaaS - Environment Config
# ==========================================

# Base System Domains
SYSTEM_DOMAIN=go.example.com
ADMIN_DOMAIN=admin.example.com
SHORTENER_FQDN=go.example.com

# Database Connection (PostgreSQL / Supabase)
DB_HOST=db.example.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=postgres
DB_SSL=false

# Supabase REST API Credentials (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://db.example.com/p/link-shortener
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=7d
